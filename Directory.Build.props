<Project>
  <!--
    Shared build settings for every project in the repository.
    The plugin version lives here only; meta.json, the release zip name and the
    CHANGELOG check all read it from this file.
  -->
  <PropertyGroup>
    <Version>0.1.0.0</Version>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <!-- Jellyfin 12.x. The packages are the lowest 12.x release, so the build loads on every 12.x server. -->
    <JellyfinPackageVersion>12.0.0</JellyfinPackageVersion>
    <!-- The SQLite library the Jellyfin 12 server itself ships (Microsoft.Data.Sqlite 10.0.x, assembly 10.0.0.0). -->
    <SqlitePackageVersion>10.0.0</SqlitePackageVersion>
  </PropertyGroup>
</Project>
